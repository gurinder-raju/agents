# Private: never commit what this agent is used for.
# Real job files: prompts, URLs, what to do with the content, and your own skills (jobs/skills/)
# and tools (jobs/tools/), such as a decoder for one community's conventions.
jobs/
# Step-by-step run records; they contain prompts and model output.
traces/
# Whatever the agent produces.
outputs/
# Saved sessions and snapshots.
.agent/
# Gateway source bindings and local credential references.
gateway.toml
gateway.local.toml
# Local settings and, later, AWS credentials.
.env
.env.*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Claude Code: personal settings and notes (saved commands can hold secrets)
**/.claude/settings.local.json
CLAUDE.local.md
